{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mihon Source Recipe v2",
  "type": "object",
  "$defs": {
    "requestSpec": {
      "type": ["object", "null"],
      "properties": {
        "method": { "type": "string", "enum": ["GET", "POST"] },
        "pathTemplate": { "type": "string", "minLength": 1 },
        "firstPagePathTemplate": { "type": ["string", "null"] },
        "headers": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": { "type": "string" }
        },
        "bodyTemplate": { "type": ["string", "null"] },
        "contentType": { "type": ["string", "null"] },
        "graphqlQuery": { "type": ["string", "null"] },
        "graphqlVariablesTemplate": { "type": ["string", "null"] }
      },
      "required": ["pathTemplate"],
      "additionalProperties": true
    },
    "authPreFlightSpec": {
      "type": ["object", "null"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "method": { "type": "string", "enum": ["GET", "POST"] },
        "headers": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": { "type": "string" }
        },
        "bodyTemplate": { "type": ["string", "null"] },
        "extractMode": { "type": "string", "enum": ["JSON_PATH", "REGEX", "CSS", "HEADER"] },
        "extractPattern": { "type": "string", "minLength": 1 },
        "cacheTtlSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "targetHeader": { "type": ["string", "null"] },
        "valuePrefix": { "type": ["string", "null"] }
      },
      "required": ["url", "extractMode", "extractPattern"],
      "additionalProperties": true
    },
    "paginationSpec": {
      "type": ["object", "null"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "PAGE_NUMBER",
            "NEXT_SELECTOR",
            "JSON_HAS_NEXT",
            "JSON_PAGE_COMPARE",
            "JSON_CURSOR",
            "OFFSET_LIMIT"
          ]
        },
        "startPage": { "type": "integer", "minimum": 0 },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 200 },
        "hasNextPath": { "type": ["string", "null"] },
        "currentPagePath": { "type": ["string", "null"] },
        "lastPagePath": { "type": ["string", "null"] },
        "nextCursorPath": { "type": ["string", "null"] },
        "nextUrlPath": { "type": ["string", "null"] },
        "cursorParam": { "type": "string" },
        "maxPages": { "type": "integer", "minimum": 1, "maximum": 250 }
      },
      "additionalProperties": true
    },
    "htmlExtractSpec": {
      "type": ["object", "null"],
      "properties": {
        "titleSelector": { "type": ["string", "null"] },
        "urlSelector": { "type": ["string", "null"] },
        "coverSelector": { "type": ["string", "null"] },
        "dateSelector": { "type": ["string", "null"] },
        "baseUrl": { "type": ["string", "null"], "format": "uri" }
      },
      "additionalProperties": true
    },
    "accountSyncSectionSpec": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["FAVORITES", "READING_HISTORY"] },
        "format": { "type": "string", "enum": ["HTML", "JSON"] },
        "request": { "$ref": "#/$defs/requestSpec" },
        "itemsSelector": { "type": "string", "minLength": 1 },
        "urlSelector": { "type": "string", "minLength": 1 },
        "titleSelector": { "type": ["string", "null"] },
        "coverSelector": { "type": ["string", "null"] },
        "lastChapterSelector": { "type": ["string", "null"] },
        "lastChapterUrlSelector": { "type": ["string", "null"] },
        "urlTemplate": { "type": ["string", "null"] },
        "nextPageSelector": { "type": ["string", "null"] },
        "pagination": { "$ref": "#/$defs/paginationSpec" }
      },
      "required": ["itemsSelector", "urlSelector"],
      "additionalProperties": true
    },
    "accountSyncSpec": {
      "type": ["object", "null"],
      "properties": {
        "loginUrl": { "type": "string", "minLength": 1 },
        "loggedOutStatusCodes": {
          "type": "array",
          "items": { "type": "integer", "minimum": 100, "maximum": 599 }
        },
        "loggedOutBodyMarkers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "loggedOutRedirectContains": {
          "type": "array",
          "items": { "type": "string" }
        },
        "maxPagesPerSection": { "type": "integer", "minimum": 1, "maximum": 50 },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/accountSyncSectionSpec" }
        }
      },
      "required": ["sections"],
      "additionalProperties": true
    },
    "pipelineStepsSpec": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "css_select",
              "regex_extract",
              "base64_decode",
              "url_resolve",
              "trim_normalize",
              "grid_unscramble",
              "json_path",
              "hex_decode",
              "xor_decrypt",
              "aes_cbc_decrypt",
              "aes_ecb_decrypt",
              "dynamic_crypto",
              "referer_bind",
              "lz_string",
              "gzip_decompress",
              "deflate_decompress",
              "decompress",
              "aes_gcm_decrypt",
              "openssl_salted_decrypt",
              "quickjs_eval"
            ]
          },
          "selector": { "type": "string" },
          "attribute": { "type": ["string", "null"] },
          "takeFirst": { "type": "boolean" },
          "pattern": { "type": "string" },
          "group": { "type": "integer", "minimum": 0 },
          "takeAll": { "type": "boolean" },
          "urlSafe": { "type": "boolean" },
          "baseUrl": { "type": ["string", "null"], "format": "uri" },
          "collapseWhitespace": { "type": "boolean" },
          "columns": { "type": "integer", "minimum": 1 },
          "rows": { "type": "integer", "minimum": 1 },
          "blockWidth": { "type": ["integer", "null"], "minimum": 1 },
          "blockHeight": { "type": ["integer", "null"], "minimum": 1 },
          "permutation": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 }
          },
          "rotations": {
            "type": "array",
            "items": { "type": "integer", "enum": [0, 90, 180, 270] }
          },
          "seed": { "type": ["integer", "null"] },
          "imageUrlContains": { "type": ["string", "null"] },
          "format": { "type": "string", "enum": ["PNG", "WEBP", "JPEG", "JPG"] },
          "expression": { "type": "string" },
          "trimWhitespace": { "type": "boolean" },
          "keyHex": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]+$" },
          "ivHex": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]+$" },
          "ivPrepend": { "type": "boolean" },
          "ivPrepend12": { "type": "boolean" },
          "ivPrepend16": { "type": "boolean" },
          "password": { "type": ["string", "null"] },
          "algorithm": {
            "type": ["string", "null"],
            "enum": [
              "AES_CBC",
              "AES_ECB",
              "AES_GCM",
              "OPENSSL_SALTED",
              "CRYPTOJS_JSON",
              "XOR",
              "GZIP",
              "DEFLATE",
              "LZ_STRING_BASE64",
              "LZ_STRING_URI",
              null
            ]
          },
          "keyUtf8": { "type": ["string", "null"] },
          "keyBase64": { "type": ["string", "null"] },
          "keyRegex": { "type": ["string", "null"] },
          "keySelector": { "type": ["string", "null"] },
          "ivUtf8": { "type": ["string", "null"] },
          "ivBase64": { "type": ["string", "null"] },
          "ivRegex": { "type": ["string", "null"] },
          "ivSelector": { "type": ["string", "null"] },
          "inputFormat": {
            "type": ["string", "null"],
            "enum": ["AUTO", "UTF8", "BASE64", "HEX", "CRYPTOJS_JSON", "RAW", "BYTES", null]
          },
          "outputFormat": {
            "type": ["string", "null"],
            "enum": ["UTF8", "BASE64", "HEX", null]
          },
          "refererUrl": { "type": "string", "format": "uri" },
          "stripMode": { "type": ["string", "null"] },
          "seedFromUrlRegex": { "type": ["string", "null"] },
          "seedUrlRegex": { "type": ["string", "null"] },
          "keepEdge": { "type": "boolean" },
          "splitFirst": { "type": "boolean" },
          "mode": {
            "type": ["string", "null"],
            "enum": [
              "GRID",
              "STRIP_VERTICAL",
              "PUBLUS",
              "SPEEDBINB",
              "BASE64",
              "URI",
              "URI_COMPONENT",
              "ENCODED_URI_COMPONENT",
              null
            ]
          },
          "remainderPolicy": { "type": "string", "enum": ["KEEP_EDGE", "SPLIT_FIRST"] },
          "seedHeaderName": { "type": ["string", "null"] },
          "hashSeedTemplate": { "type": ["string", "null"] },
          "hashAlgorithm": { "type": ["string", "null"], "enum": ["MD5", "SHA-256", null] },
          "script": { "type": "string", "maxLength": 16384 },
          "preset": { "type": ["string", "null"], "enum": ["PACKER", "NEXT_RSC", "CUSTOM", null] },
          "outputVar": { "type": ["string", "null"], "pattern": "^[a-zA-Z_$][a-zA-Z0-9_$]*$" },
          "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 3000 }
        },
        "allOf": [
          {
            "if": { "properties": { "op": { "const": "grid_unscramble" } }, "required": ["op"] },
            "then": {
              "properties": {
                "mode": { "type": ["string", "null"], "enum": ["GRID", "STRIP_VERTICAL", "PUBLUS", "SPEEDBINB", null] }
              }
            }
          },
          {
            "if": { "properties": { "op": { "const": "lz_string" } }, "required": ["op"] },
            "then": {
              "properties": {
                "mode": {
                  "type": ["string", "null"],
                  "enum": ["BASE64", "URI", "URI_COMPONENT", "ENCODED_URI_COMPONENT", null]
                }
              }
            }
          },
          {
            "if": { "properties": { "op": { "const": "decompress" } }, "required": ["op"] },
            "then": {
              "required": ["op", "algorithm"],
              "properties": {
                "algorithm": { "type": "string", "enum": ["GZIP", "DEFLATE", "LZ_STRING_BASE64", "LZ_STRING_URI"] }
              }
            }
          },
          {
            "if": { "properties": { "op": { "const": "dynamic_crypto" } }, "required": ["op"] },
            "then": {
              "properties": {
                "algorithm": {
                  "type": ["string", "null"],
                  "enum": ["AES_CBC", "AES_ECB", "AES_GCM", "OPENSSL_SALTED", "CRYPTOJS_JSON", "XOR", null]
                }
              }
            }
          },
          {
            "if": { "properties": { "op": { "const": "aes_ecb_decrypt" } }, "required": ["op"] },
            "then": {
              "required": ["op", "keyHex"],
              "properties": {
                "keyHex": { "type": "string", "pattern": "^([0-9a-fA-F]{32}|[0-9a-fA-F]{48}|[0-9a-fA-F]{64})$" }
              }
            }
          },
          {
            "if": { "properties": { "op": { "const": "aes_cbc_decrypt" } }, "required": ["op"] },
            "then": {
              "required": ["op", "keyHex"],
              "properties": {
                "ivHex": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{32}$" }
              }
            }
          },
          {
            "if": { "properties": { "op": { "const": "aes_gcm_decrypt" } }, "required": ["op"] },
            "then": {
              "required": ["op", "keyHex"],
              "properties": {
                "ivHex": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{24}$" }
              }
            }
          }
        ],
        "required": ["op"],
        "additionalProperties": true
      }
    }
  },
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [1, 2]
    },
    "sourceId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9._-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "baseUrl": {
      "type": "string",
      "format": "uri"
    },
    "lang": {
      "type": "string",
      "minLength": 2,
      "maxLength": 12,
      "pattern": "^[a-zA-Z]{2,5}(-[a-zA-Z0-9]{2,8})*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "versionId": {
      "type": "integer",
      "minimum": 1
    },
    "preset": {
      "type": "string",
      "enum": ["MADARA", "MANGA_THEMESIA", "MANGA_READER_CMS", "CSS_GENERIC", "JSON_API"]
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "ACTIVE", "QUARANTINED", "DISABLED"]
    },
    "family": {
      "type": "string",
      "enum": ["STANDARD", "QWIK_SERIES", "INERTIA_SSR", "DATATABLES_AJAX", "MULTI_VIEW_HTML"]
    },
    "maxHtmlBytes": {
      "type": "integer",
      "minimum": 65536,
      "maximum": 3145728
    },
    "selectors": {
      "type": ["object", "null"],
      "properties": {
        "listSelector": { "type": "string", "minLength": 1 },
        "titleSelector": { "type": ["string", "null"] },
        "linkSelector": { "type": ["string", "null"] },
        "coverSelector": { "type": ["string", "null"] },
        "chapterSelector": { "type": ["string", "null"] },
        "pageImgSelector": { "type": ["string", "null"] },
        "nextPageSelector": { "type": ["string", "null"] },
        "detailsTitleSelector": { "type": ["string", "null"] },
        "detailsCoverSelector": { "type": ["string", "null"] },
        "descriptionSelector": { "type": ["string", "null"] },
        "authorSelector": { "type": ["string", "null"] },
        "artistSelector": { "type": ["string", "null"] },
        "genresSelector": { "type": ["string", "null"] },
        "statusSelector": { "type": ["string", "null"] },
        "chapterNameSelector": { "type": ["string", "null"] },
        "chapterDateSelector": { "type": ["string", "null"] },
        "chapterDateFormat": { "type": ["string", "null"] }
      },
      "required": ["listSelector"],
      "additionalProperties": true
    },
    "requiresCloudflareBypass": {
      "type": "boolean"
    },
    "requiresWebViewCapture": {
      "type": "boolean"
    },
    "catalogPath": {
      "type": ["string", "null"]
    },
    "searchPath": {
      "type": ["string", "null"]
    },
    "headers": {
      "type": "object",
      "maxProperties": 16,
      "additionalProperties": { "type": "string" }
    },
    "useHomeFallback": {
      "type": "boolean"
    },
    "mirrors": {
      "type": "array",
      "items": { "type": "string", "format": "uri" }
    },
    "iconUrl": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "upstreamSourceId": {
      "type": ["integer", "null"]
    },
    "upstreamSourceIds": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "upstreamExtVersionCode": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "upstreamRepo": {
      "type": ["string", "null"]
    },
    "recipePath": {
      "type": ["string", "null"]
    },
    "mode": {
      "type": ["string", "null"]
    },
    "pkgName": {
      "type": ["string", "null"]
    },
    "versionCode": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "license": {
      "type": ["string", "null"]
    },
    "attribution": {
      "type": ["string", "null"]
    },
    "popularRequest": { "$ref": "#/$defs/requestSpec" },
    "latestRequest": { "$ref": "#/$defs/requestSpec" },
    "searchRequest": { "$ref": "#/$defs/requestSpec" },
    "detailsRequest": { "$ref": "#/$defs/requestSpec" },
    "chaptersRequest": { "$ref": "#/$defs/requestSpec" },
    "pagesRequest": { "$ref": "#/$defs/requestSpec" },
    "jsonApi": {
      "type": ["object", "null"],
      "properties": {
        "apiBaseUrl": { "type": ["string", "null"], "format": "uri" },
        "defaultOrg": { "type": ["string", "null"] },
        "langMap": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "popularRequest": { "$ref": "#/$defs/requestSpec" },
        "latestRequest": { "$ref": "#/$defs/requestSpec" },
        "searchRequest": { "$ref": "#/$defs/requestSpec" },
        "detailsRequest": { "$ref": "#/$defs/requestSpec" },
        "chaptersRequest": { "$ref": "#/$defs/requestSpec" },
        "pagesRequest": { "$ref": "#/$defs/requestSpec" },
        "searchFallbackPages": { "type": "integer", "minimum": 1, "maximum": 20 },
        "mangaUrlTemplate": { "type": ["string", "null"] },
        "chapterUrlTemplate": { "type": ["string", "null"] },
        "imageHeaders": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": { "type": "string" }
        },
        "mangaList": {
          "type": ["object", "null"],
          "properties": {
            "itemsPath": { "type": "string", "minLength": 1 },
            "titlePaths": { "type": "array", "items": { "type": "string" } },
            "urlTemplate": { "type": ["string", "null"] },
            "urlPath": { "type": ["string", "null"] },
            "slugPath": { "type": ["string", "null"] },
            "orgPath": { "type": ["string", "null"] },
            "idPath": { "type": ["string", "null"] },
            "coverPaths": { "type": "array", "items": { "type": "string" } },
            "coverBaseUrl": { "type": ["string", "null"], "format": "uri" },
            "htmlExtract": { "$ref": "#/$defs/htmlExtractSpec" },
            "pipelineSteps": { "$ref": "#/$defs/pipelineStepsSpec" },
            "pagination": { "$ref": "#/$defs/paginationSpec" }
          },
          "required": ["itemsPath"],
          "additionalProperties": true
        },
        "details": {
          "type": ["object", "null"],
          "properties": {
            "rootPath": { "type": "string" },
            "titlePaths": { "type": "array", "items": { "type": "string" } },
            "descriptionPaths": { "type": "array", "items": { "type": "string" } },
            "stripHtmlInDescription": { "type": "boolean" },
            "coverPaths": { "type": "array", "items": { "type": "string" } },
            "genresPath": { "type": ["string", "null"] },
            "extraGenrePaths": { "type": "array", "items": { "type": "string" } },
            "authorsPath": { "type": ["string", "null"] },
            "artistsPath": { "type": ["string", "null"] },
            "statusPath": { "type": ["string", "null"] },
            "statusMap": {
              "type": "object",
              "additionalProperties": { "type": "integer" }
            },
            "urlTemplate": { "type": ["string", "null"] },
            "idPath": { "type": ["string", "null"] },
            "slugPath": { "type": ["string", "null"] },
            "pipelineSteps": { "$ref": "#/$defs/pipelineStepsSpec" }
          },
          "additionalProperties": true
        },
        "chapters": {
          "type": ["object", "null"],
          "properties": {
            "itemsPath": { "type": "string", "minLength": 1 },
            "urlTemplate": { "type": ["string", "null"] },
            "urlPath": { "type": ["string", "null"] },
            "idPath": { "type": ["string", "null"] },
            "namePath": { "type": ["string", "null"] },
            "nameTemplate": { "type": ["string", "null"] },
            "numberPath": { "type": ["string", "null"] },
            "datePath": { "type": ["string", "null"] },
            "dateFormat": { "type": ["string", "null"] },
            "scanlatorPath": { "type": ["string", "null"] },
            "defaultScanlator": { "type": ["string", "null"] },
            "skipIfTruePath": { "type": ["string", "null"] },
            "skipIfNonBlankPath": { "type": ["string", "null"] },
            "lockedPath": { "type": ["string", "null"] },
            "sortDescending": { "type": "boolean" },
            "htmlExtract": { "$ref": "#/$defs/htmlExtractSpec" },
            "pipelineSteps": { "$ref": "#/$defs/pipelineStepsSpec" },
            "pagination": { "$ref": "#/$defs/paginationSpec" }
          },
          "required": ["itemsPath"],
          "additionalProperties": true
        },
        "pages": {
          "type": ["object", "null"],
          "properties": {
            "itemsPath": { "type": "string", "minLength": 1 },
            "imageUrlPath": { "type": ["string", "null"] },
            "orderPath": { "type": ["string", "null"] },
            "decoyTriggerPath": { "type": ["string", "null"] },
            "excludedImageTokens": { "type": "array", "items": { "type": "string" } },
            "imageHeaders": {
              "type": "object",
              "maxProperties": 16,
              "additionalProperties": { "type": "string" }
            },
            "pipelineSteps": { "$ref": "#/$defs/pipelineStepsSpec" },
            "requiresReaderHtmlFallback": { "type": "boolean" },
            "readerHtmlPageSelector": { "type": ["string", "null"] },
            "readerHtmlRegex": { "type": ["string", "null"] },
            "readerHtmlAllowedTokens": { "type": "array", "items": { "type": "string" } },
            "readerHtmlExcludedTokens": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["itemsPath"],
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "qwik": {
      "type": ["object", "null"],
      "properties": {
        "seriesPath": { "type": "string" },
        "pageParam": { "type": "string" },
        "searchQrlHash": { "type": "string", "minLength": 1 },
        "defaultSearchChunk": { "type": "string", "minLength": 1 },
        "chunkBuildPrefix": { "type": "string" },
        "searchPageSize": { "type": "integer", "minimum": 1, "maximum": 200 },
        "coverOriginRegex": { "type": ["string", "null"] },
        "defaultCoverOrigin": { "type": ["string", "null"], "format": "uri" },
        "seriesLinkSelector": { "type": "string" },
        "chapterLinkSelector": { "type": "string" },
        "pageUrlRegex": { "type": ["string", "null"] },
        "requiredChapterSegmentRegex": { "type": ["string", "null"] },
        "excludedImageTokens": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["searchQrlHash", "defaultSearchChunk"],
      "additionalProperties": true
    },
    "inertia": {
      "type": ["object", "null"],
      "properties": {
        "scriptSelector": { "type": "string", "minLength": 1 },
        "seriesListPath": { "type": "string" },
        "seriesDetailsPath": { "type": "string" },
        "chaptersPath": { "type": "string" },
        "pagesPath": { "type": "string" },
        "nextPagesPath": { "type": "string" },
        "nextListUrlPath": { "type": "string" },
        "lockedComponentName": { "type": ["string", "null"] },
        "chapterLockedPath": { "type": ["string", "null"] },
        "urlRewriteHosts": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "multiViewReader": {
      "type": ["object", "null"],
      "properties": {
        "urlTemplate": { "type": "string", "minLength": 1 },
        "maxViews": { "type": "integer", "minimum": 1, "maximum": 100 },
        "minItemsPerView": { "type": "integer", "minimum": 1, "maximum": 200 }
      },
      "required": ["urlTemplate"],
      "additionalProperties": true
    },
    "querySigner": {
      "type": ["object", "null"],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sbox_xor_cbc",
            "hmac_sha256",
            "hmac_sha1",
