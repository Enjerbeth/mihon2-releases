{
  "schemaVersion": 2,
  "sourceId": "pt.mangafire",
  "name": "MangaFire",
  "baseUrl": "https://mangafire.to",
  "lang": "pt",
  "version": 1,
  "versionId": 1,
  "preset": "JSON_API",
  "status": "ACTIVE",
  "maxHtmlBytes": 2097152,
  "headers": {
    "Referer": "https://mangafire.to/"
  },
  "mirrors": [
    "https://mangafire.to"
  ],
  "selectors": {
    "listSelector": "$.items[*]"
  },
  "jsonApi": {
    "langMap": {
      "es-419": "es-la",
      "pt-BR": "pt-br"
    },
    "popularRequest": {
      "method": "GET",
      "pathTemplate": "/api/titles?order[views_30d]=desc&languages[]={lang}&page={page}&limit=50"
    },
    "latestRequest": {
      "method": "GET",
      "pathTemplate": "/api/titles?order[chapter_updated_at]=desc&languages[]={lang}&page={page}&limit=50"
    },
    "searchRequest": {
      "method": "GET",
      "pathTemplate": "/api/titles?keyword={query}&languages[]={lang}&page={page}&limit=50"
    },
    "detailsRequest": {
      "method": "GET",
      "pathTemplate": "/api/titles/{hid}"
    },
    "chaptersRequest": {
      "method": "GET",
      "pathTemplate": "/api/titles/{hid}/chapters?language={lang}&page={page}&limit=50"
    },
    "pagesRequest": {
      "method": "GET",
      "pathTemplate": "/api/chapters/{chapterId}"
    },
    "mangaList": {
      "itemsPath": "$.items[*]",
      "idPath": "$.hid",
      "slugPath": "$.slug",
      "titlePaths": [
        "$.title"
      ],
      "urlTemplate": "/title/{id}-{slug}",
      "coverPaths": [
        "$.poster.large",
        "$.poster.medium",
        "$.poster.small"
      ],
      "pagination": {
        "mode": "JSON_HAS_NEXT",
        "startPage": 1,
        "pageSize": 50,
        "hasNextPath": "$.meta.hasNext"
      }
    },
    "details": {
      "rootPath": "$.data",
      "idPath": "$.hid",
      "slugPath": "$.slug",
      "urlTemplate": "/title/{id}-{slug}",
      "titlePaths": [
        "$.title"
      ],
      "descriptionPaths": [
        "$.synopsisHtml"
      ],
      "stripHtmlInDescription": true,
      "coverPaths": [
        "$.poster.large",
        "$.poster.medium",
        "$.poster.small"
      ],
      "authorsPath": "$.authors[*].title",
      "artistsPath": "$.artists[*].title",
      "genresPath": "$.genres[*].title",
      "extraGenrePaths": [
        "$.type",
        "$.themes[*].title"
      ],
      "statusPath": "$.status",
      "statusMap": {
        "releasing": 1,
        "finished": 2,
        "on_hiatus": 6,
        "discontinued": 5
      }
    },
    "chapters": {
      "itemsPath": "$.items[*]",
      "idPath": "$.id",
      "numberPath": "$.number",
      "namePath": "$.name",
      "urlTemplate": "{mangaUrl}/{id}-chapter-{number}-{lang}",
      "scanlatorPath": "$.type",
      "defaultScanlator": "Unknown",
      "datePath": "$.createdAt",
      "dateFormat": "epoch_seconds",
      "pagination": {
        "mode": "JSON_HAS_NEXT",
        "startPage": 1,
        "pageSize": 50,
        "hasNextPath": "$.meta.hasNext",
        "currentPagePath": "$.meta.currentPage",
        "lastPagePath": "$.meta.lastPage",
        "maxPages": 200
      }
    },
    "pages": {
      "itemsPath": "$.data.pages[*]",
      "imageUrlPath": "$.url"
    }
  },
  "pipelineSteps": [
    {
      "op": "referer_bind",
      "refererUrl": "https://mangafire.to/"
    }
  ],
  "upstreamSourceId": 758400875161895515,
  "upstreamRepo": "keiyoushi/extensions-source",
  "upstreamExtVersionCode": 106039,
  "querySigner": {
    "algorithm": "sbox_xor_cbc",
    "pathPrefix": "/api",
    "stripPathPrefix": true,
    "paramName": "vrf",
    "stages": [
      {
        "tableBase64": "",
        "keyBase64": "0Ec58JOY3uBzJK9m3zqIOpdlF7UFiax9DmA=",
        "iv": 90
      },
      {
