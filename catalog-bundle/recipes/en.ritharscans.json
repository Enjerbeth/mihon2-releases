  "upstreamRepo": "keiyoushi/extensions-source",
  "multisrcTheme": "keyoapp",
  "popularRequest": {
    "method": "GET",
    "pathTemplate": "/series?page={page}",
    "firstPagePathTemplate": "/series"
  },
  "latestRequest": {
    "method": "GET",
    "pathTemplate": "/latest?page={page}",
    "firstPagePathTemplate": "/latest"
  },
  "requiresCloudflareBypass": true,
  "requiresWebViewCapture": false
