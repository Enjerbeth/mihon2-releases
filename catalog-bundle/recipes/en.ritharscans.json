    "listSelector": "article, div.manga-item, div.page-item-detail",
    "titleSelector": "h3 a, h4 a, a",
    "linkSelector": "a",
    "coverSelector": "img.card-img-top, div.series-thumb img",
    "chapterSelector": "li a, div.chapter-item a",
    "pageImgSelector": "div.reading-content img, div#readerarea img",
    "nextPageSelector": "a.next-page, a.next",
    "detailsTitleSelector": "h1.series-title, h1.title",
    "detailsCoverSelector": "div.series-poster img",
    "descriptionSelector": "div.series-synopsis, div.synopsis",
    "authorSelector": "div.author a, span.author",
    "statusSelector": "div.status, span.status"
  },
  "pipelineSteps": [
    {
      "op": "referer_bind",
      "refererUrl": "https://ritharscans.com/"
    }
  ],
