{
  "schemaVersion": 2,
  "sourceId": "en.guya",
  "name": "Guya",
  "baseUrl": "https://guya.cubari.moe",
  "lang": "en",
  "version": 1,
  "versionId": 1,
  "preset": "JSON_API",
  "status": "ACTIVE",
  "maxHtmlBytes": 2097152,
  "catalogPath": "/api/get_all_series/",
  "useHomeFallback": true,
  "headers": {
    "Referer": "https://guya.cubari.moe/"
  },
  "selectors": {
    "listSelector": "article, div.manga-item, div.page-item-detail",
    "titleSelector": "h3 a, h4 a, a",
    "linkSelector": "a",
    "chapterSelector": "li a, div.chapter-item a",
    "pageImgSelector": "div.reading-content img, div#readerarea img"
  },
  "pipelineSteps": [
    {
      "op": "referer_bind",
      "refererUrl": "https://guya.cubari.moe/"
    }
  ],
  "recipePath": "recipes/en.guya.json",
  "mode": "declarative",
  "upstreamSourceIds": [
    4637971935551651734
  ],
  "license": "Apache-2.0",
  "attribution": "The Tachiyomi / Keiyoushi Contributors",
  "mirrors": [
    "https://guya.cubari.moe"
  ],
  "iconUrl": "https://cdn.jsdelivr.net/gh/keiyoushi/extensions-source@main/src/en/guya/res/mipmap-xhdpi/ic_launcher.png",
  "pkgName": "eu.kanade.tachiyomi.extension.en.guya",
  "upstreamSourceId": 4637971935551651734,
  "upstreamExtVersionCode": 106002,
  "versionCode": 106002,
  "upstreamRepo": "keiyoushi/extensions-source",
  "jsonApi": {
    "apiBaseUrl": "https://guya.cubari.moe",
    "popularRequest": {
      "method": "GET",
      "pathTemplate": "/api/get_all_series/",
      "headers": {
        "Accept": "application/json",
        "Referer": "https://guya.cubari.moe/"
      }
    },
    "latestRequest": {
      "method": "GET",
      "pathTemplate": "/api/get_all_series/",
      "headers": {
        "Accept": "application/json",
        "Referer": "https://guya.cubari.moe/"
      }
    },
    "searchRequest": {
      "method": "GET",
      "pathTemplate": "/api/get_all_series/",
      "headers": {
        "Accept": "application/json",
        "Referer": "https://guya.cubari.moe/"
      }
    },
    "detailsRequest": {
      "method": "GET",
      "pathTemplate": "/api/series/{slug}/",
      "headers": {
        "Accept": "application/json",
        "Referer": "https://guya.cubari.moe/"
      }
    },
    "chaptersRequest": {
      "method": "GET",
      "pathTemplate": "/api/series/{slug}/",
      "headers": {
        "Accept": "application/json",
        "Referer": "https://guya.cubari.moe/"
      }
    },
    "mangaList": {
      "itemsPath": "$.*",
      "titlePaths": [
        "$.title"
      ],
      "slugPath": "$.slug",
      "urlTemplate": "/read/manga/{slug}/",
      "coverBaseUrl": "https://guya.cubari.moe",
      "coverPaths": [
        "$.cover"
      ],
      "pagination": {
        "mode": "PAGE_NUMBER",
        "startPage": 1,
        "pageSize": 100
      }
    },
    "details": {
      "rootPath": "$",
      "titlePaths": [
        "$.title"
      ],
      "descriptionPaths": [
        "$.description"
      ],
      "coverPaths": [
        "$.cover"
      ],
      "authorsPath": "$.author",
      "artistsPath": "$.artist"
    },
    "chapters": {
      "itemsPath": "$.chapters.*",
      "namePath": "$.title",
      "numberPath": "$.chapter",
      "datePath": "$.release_date"
    },
    "pages": {
      "itemsPath": "$.groups.*[*]",
      "imageUrlPath": "$.*"
    }
  }
}
