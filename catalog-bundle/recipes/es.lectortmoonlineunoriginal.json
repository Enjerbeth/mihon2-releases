{
  "schemaVersion": 2,
  "sourceId": "es.lectortmoonlineunoriginal",
  "name": "LectorTmo.online (unoriginal)",
  "baseUrl": "https://lectortmo.online",
  "lang": "es",
  "version": 2,
  "versionId": 1,
  "preset": "JSON_API",
  "status": "ACTIVE",
  "curated": true,
  "maxHtmlBytes": 2097152,
  "catalogPath": "/manga",
  "useHomeFallback": true,
  "headers": {},
  "selectors": null,
  "pipelineSteps": [],
  "recipePath": "recipes/es.lectortmoonlineunoriginal.json",
  "mode": "declarative",
  "upstreamSourceIds": [
    5421672499331648652
  ],
  "license": "Apache-2.0",
  "attribution": "The Tachiyomi / Keiyoushi Contributors",
  "mirrors": [
    "https://lectortmo.online"
  ],
  "iconUrl": "https://cdn.jsdelivr.net/gh/keiyoushi/extensions-source@main/src/es/lectortmoonlineunoriginal/res/mipmap-xhdpi/ic_launcher.png",
  "pkgName": "eu.kanade.tachiyomi.extension.es.lectortmoonlineunoriginal",
  "upstreamSourceId": 5421672499331648652,
  "upstreamExtVersionCode": 106001,
  "versionCode": 106001,
  "upstreamRepo": "keiyoushi/extensions-source",
  "jsonApi": {
    "apiBaseUrl": "https://lectortmo.online",
    "popularRequest": {
      "method": "GET",
      "pathTemplate": "/api/mangas?order=views&lang=es&per_page=30&page={page}"
    },
    "latestRequest": {
      "method": "GET",
      "pathTemplate": "/api/mangas?order=date&lang=es&per_page=30&page={page}"
    },
    "searchRequest": {
      "method": "GET",
      "pathTemplate": "/api/mangas?q={query}&order=views&lang=es&per_page=30&page={page}"
    },
    "detailsRequest": {
      "method": "GET",
      "pathTemplate": "/api/mangas/{slug}"
    },
    "chaptersRequest": {
      "method": "GET",
      "pathTemplate": "/api/mangas/{slug}"
    },
    "pagesRequest": {
      "method": "GET",
      "pathTemplate": "/api/chapters/{chapterSlug}"
    },
    "mangaUrlTemplate": "{baseUrl}/manga/{slug}",
    "chapterUrlTemplate": "{baseUrl}/{chapterSlug}",
    "mangaList": {
      "itemsPath": "$.data[*]",
      "titlePaths": [
        "$.title"
      ],
      "urlTemplate": "{slug}",
      "slugPath": "$.slug",
      "coverPaths": [
        "$.cover"
      ],
      "pagination": {
        "mode": "JSON_PAGE_COMPARE",
        "startPage": 1,
        "pageSize": 30,
        "currentPagePath": "$.meta.current_page",
        "lastPagePath": "$.meta.last_page"
      }
    },
    "details": {
      "rootPath": "$.data",
      "titlePaths": [
        "$.title"
      ],
      "descriptionPaths": [
        "$.synopsis",
        "$.description"
      ],
      "coverPaths": [
        "$.cover"
      ],
      "authorsPath": "$.author",
      "artistsPath": "$.artist",
      "genresPath": "$.genres[*].name",
      "extraGenrePaths": [
        "$.type"
      ],
      "statusPath": "$.status"
    },
    "chapters": {
      "itemsPath": "$.data.chapters[*]",
      "namePath": "$.title",
      "urlPath": "$.slug",
      "numberPath": "$.number",
      "datePath": "$.created_at"
    },
    "pages": {
      "itemsPath": "$.data.pages[*]",
      "imageUrlPath": "$"
    }
  },
  "requiresCloudflareBypass": true,
  "requiresWebViewCapture": false
}
