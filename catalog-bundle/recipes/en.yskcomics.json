{
  "schemaVersion": 2,
  "sourceId": "en.yskcomics",
  "name": "YSK Comics",
  "baseUrl": "https://www.ysk-comics.com",
  "lang": "en",
  "version": 1,
  "versionId": 1,
  "preset": "JSON_API",
  "status": "ACTIVE",
  "maxHtmlBytes": 2097152,
  "catalogPath": "/manga",
  "useHomeFallback": true,
  "headers": {
    "Referer": "https://www.ysk-comics.com/"
  },
  "selectors": null,
  "pipelineSteps": [
    {
      "op": "referer_bind",
      "refererUrl": "https://www.ysk-comics.com/"
    }
  ],
  "recipePath": "recipes/en.yskcomics.json",
  "mode": "declarative",
  "upstreamSourceIds": [
    177448809266948921
  ],
  "license": "Apache-2.0",
  "attribution": "The Tachiyomi / Keiyoushi Contributors",
  "mirrors": [
    "https://www.ysk-comics.com"
  ],
  "iconUrl": "https://cdn.jsdelivr.net/gh/keiyoushi/extensions-source@main/src/all/yskcomics/res/mipmap-xhdpi/ic_launcher.png",
  "pkgName": "eu.kanade.tachiyomi.extension.all.yskcomics",
  "upstreamSourceId": 177448809266948921,
  "upstreamExtVersionCode": 106003,
  "versionCode": 106003,
  "upstreamRepo": "keiyoushi/extensions-source",
  "jsonApi": {
    "apiBaseUrl": "https://www.ysk-comics.com",
    "popularRequest": {
      "method": "GET",
      "pathTemplate": "/api/home/best-comics"
    },
    "latestRequest": {
      "method": "GET",
      "pathTemplate": "/api/home/latest-comics?page={page}"
    },
    "searchRequest": {
      "method": "GET",
      "pathTemplate": "/?name={query}"
    },
    "detailsRequest": {
      "method": "GET",
      "pathTemplate": "/api/comic/{slug}"
    },
    "chaptersRequest": {
      "method": "GET",
      "pathTemplate": "/page/{page}"
    },
    "pagesRequest": {
      "method": "GET",
      "pathTemplate": "/api/chapters/images/{slug}"
    },
    "mangaList": {
      "itemsPath": "$.data[*]",
      "titlePaths": [
        "$.title",
        "$.name"
      ],
      "urlPath": "$.url",
      "slugPath": "$.slug",
      "idPath": "$.id",
      "coverPaths": [
        "$.cover",
        "$.thumbnail",
        "$.image"
      ],
      "pagination": {
        "mode": "PAGE_NUMBER",
        "startPage": 1,
        "pageSize": 24
      }
    },
    "details": {
      "rootPath": "$.data",
      "titlePaths": [
        "$.title",
        "$.name"
      ],
      "descriptionPaths": [
        "$.description",
        "$.synopsis"
      ],
      "coverPaths": [
        "$.cover",
        "$.thumbnail",
        "$.image"
      ],
      "authorsPath": "$.author",
      "artistsPath": "$.artist",
      "genresPath": "$.genres[*]",
      "statusPath": "$.status"
    },
    "chapters": {
      "itemsPath": "$.chapters[*]",
      "namePath": "$.title",
      "urlPath": "$.url",
      "idPath": "$.id",
      "numberPath": "$.number",
      "datePath": "$.createdAt"
    },
    "pages": {
      "itemsPath": "$.data[*]",
      "imageUrlPath": "$.url"
    }
  }
}
