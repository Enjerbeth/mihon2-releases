{
  "schemaVersion": 2,
  "sourceId": "en.nhentai",
  "name": "NHentai",
  "baseUrl": "https://nhentai.net",
  "lang": "en",
  "version": 2,
  "versionId": 1,
  "preset": "JSON_API",
  "status": "QUARANTINED",
  "maxHtmlBytes": 2097152,
  "catalogPath": "/manga",
  "useHomeFallback": true,
  "headers": {
    "Referer": "https://nhentai.net/"
  },
  "selectors": null,
  "pipelineSteps": [
    {
      "op": "referer_bind",
      "refererUrl": "https://nhentai.net/"
    }
  ],
  "recipePath": "recipes/en.nhentai.json",
  "mode": "declarative",
  "upstreamSourceIds": [
    3122156392225024195
  ],
  "license": "Apache-2.0",
  "attribution": "FelipeGFA Contributors",
  "mirrors": [
    "https://nhentai.net"
  ],
  "iconUrl": "https://cdn.jsdelivr.net/gh/FelipeGFA/fonte-extensoes@main/src/all/nhentai/res/mipmap-xhdpi/ic_launcher.png",
  "pkgName": "eu.kanade.tachiyomi.extension.all.nhentai",
  "upstreamSourceId": 3122156392225024195,
  "upstreamExtVersionCode": 104055,
  "versionCode": 104055,
  "upstreamRepo": "FelipeGFA/fonte-extensoes",
  "jsonApi": {
    "apiBaseUrl": "https://nhentai.net",
    "popularRequest": {
      "method": "GET",
      "pathTemplate": "/search/?q=\\"
    },
    "latestRequest": {
      "method": "GET",
      "pathTemplate": "/?page={page}"
    },
    "searchRequest": {
      "method": "POST",
      "pathTemplate": "/favorites/?q={query}&page={page}&q={query}&page={page}"
    },
    "detailsRequest": {
      "method": "GET",
      "pathTemplate": "/graphql"
    },
    "chaptersRequest": {
      "method": "GET",
      "pathTemplate": "/{slug}"
    },
    "pagesRequest": {
      "method": "GET",
      "pathTemplate": "/graphql"
    },
    "mangaList": {
      "itemsPath": "$.data[*]",
      "titlePaths": [
        "$.title",
        "$.name"
      ],
      "urlPath": "$.url",
      "slugPath": "$.slug",
      "idPath": "$.id",
      "coverPaths": [
        "$.cover",
        "$.thumbnail",
        "$.image"
      ],
      "pagination": {
        "mode": "PAGE_NUMBER",
        "startPage": 1,
        "pageSize": 24
      }
    },
    "details": {
      "rootPath": "$.data",
      "titlePaths": [
        "$.title",
        "$.name"
      ],
      "descriptionPaths": [
        "$.description",
        "$.synopsis"
      ],
      "coverPaths": [
        "$.cover",
        "$.thumbnail",
        "$.image"
      ],
      "authorsPath": "$.author",
      "artistsPath": "$.artist",
      "genresPath": "$.genres[*]",
      "statusPath": "$.status"
    },
    "chapters": {
      "itemsPath": "$.data[*]",
      "namePath": "$.title",
      "urlPath": "$.url",
      "idPath": "$.id",
      "numberPath": "$.number",
      "datePath": "$.createdAt"
    },
    "pages": {
      "itemsPath": "$.pages[*]",
      "imageUrlPath": "$.url"
    }
  },
  "requiresCloudflareBypass": true,
  "requiresWebViewCapture": false
}
