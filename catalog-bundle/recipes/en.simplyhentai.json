{
  "schemaVersion": 2,
  "sourceId": "en.simplyhentai",
  "name": "Simply Hentai",
  "baseUrl": "https://www.simply-hentai.com",
  "lang": "en",
  "version": 1,
  "versionId": 2,
  "preset": "JSON_API",
  "status": "ACTIVE",
  "maxHtmlBytes": 2097152,
  "catalogPath": "/manga",
  "useHomeFallback": true,
  "headers": {
    "Referer": "https://www.simply-hentai.com/"
  },
  "selectors": null,
  "pipelineSteps": [
    {
      "op": "referer_bind",
      "refererUrl": "https://www.simply-hentai.com/"
    }
  ],
  "recipePath": "recipes/en.simplyhentai.json",
  "mode": "declarative",
  "upstreamSourceIds": [
    298934354390867671
  ],
  "license": "Apache-2.0",
  "attribution": "The Tachiyomi / Keiyoushi Contributors",
  "mirrors": [
    "https://www.simply-hentai.com"
  ],
  "iconUrl": "https://cdn.jsdelivr.net/gh/keiyoushi/extensions-source@main/src/all/simplyhentai/res/mipmap-xhdpi/ic_launcher.png",
  "pkgName": "eu.kanade.tachiyomi.extension.all.simplyhentai",
  "upstreamSourceId": 298934354390867671,
  "upstreamExtVersionCode": 106003,
  "versionCode": 106003,
  "upstreamRepo": "keiyoushi/extensions-source",
  "jsonApi": {
    "apiBaseUrl": "https://www.simply-hentai.com",
    "popularRequest": {
      "method": "GET",
      "pathTemplate": "/api/manga?page={page}"
    },
    "latestRequest": {
      "method": "GET",
      "pathTemplate": "/api/manga?page={page}"
    },
    "searchRequest": {
      "method": "GET",
      "pathTemplate": "/api/manga?page={page}&q={query}"
    },
    "detailsRequest": {
      "method": "GET",
      "pathTemplate": "/api/manga/{slug}"
    },
    "chaptersRequest": {
      "method": "GET",
      "pathTemplate": "/api/manga/{slug}/chapters"
    },
    "pagesRequest": {
      "method": "GET",
      "pathTemplate": "/api/chapters/{chapterId}/pages"
    },
    "mangaList": {
      "itemsPath": "$.data[*]",
      "titlePaths": [
        "$.title",
        "$.name"
      ],
      "urlPath": "$.url",
      "slugPath": "$.slug",
      "idPath": "$.id",
      "coverPaths": [
        "$.cover",
        "$.thumbnail",
        "$.image"
      ],
      "pagination": {
        "mode": "PAGE_NUMBER",
        "startPage": 1,
        "pageSize": 24
      }
    },
    "details": {
      "rootPath": "$.data",
      "titlePaths": [
        "$.title",
        "$.name"
      ],
      "descriptionPaths": [
        "$.description",
        "$.synopsis"
      ],
      "coverPaths": [
        "$.cover",
        "$.thumbnail",
        "$.image"
      ],
      "authorsPath": "$.author",
      "artistsPath": "$.artist",
      "genresPath": "$.genres[*]",
      "statusPath": "$.status"
    },
    "chapters": {
      "itemsPath": "$.data[*]",
      "namePath": "$.title",
      "urlPath": "$.url",
      "idPath": "$.id",
      "numberPath": "$.number",
      "datePath": "$.createdAt"
    },
    "pages": {
      "itemsPath": "$.data[*]",
      "imageUrlPath": "$.url"
    }
  },
  "requiresCloudflareBypass": true,
  "requiresWebViewCapture": false
}
