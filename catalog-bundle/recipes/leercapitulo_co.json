{
  "schemaVersion": 2,
  "sourceId": "leercapitulo_co",
  "name": "LeerCapitulo",
  "baseUrl": "https://www.leercapitulo.co",
  "lang": "es",
  "version": 1,
  "preset": "CSS_GENERIC",
  "status": "ACTIVE",
  "maxHtmlBytes": 2097152,
  "headers": {
    "Referer": "https://www.leercapitulo.co/"
  },
  "selectors": {
    "listSelector": "div.lc-card, div.cate-manga div.media",
    "titleSelector": "a.lc-card-name, h4.media-heading a",
    "linkSelector": "a.lc-card-name[href*='/manga/'], h4.media-heading a",
    "coverSelector": "a.lc-card-cover img, img",
    "chapterSelector": "a[href*='/leer/']",
    "pageImgSelector": "div.comic_wraCon img, div#all img, div.reading-content img, img[data-src]:not([src*='/covers/']):not([data-src*='/covers/']):not([src*='/assets/']):not([data-src*='/assets/']), img[src]:not([src*='/covers/']):not([src*='/assets/'])",
    "nextPageSelector": "a[href*='page={page+1}'], a[rel=next]"
  },
  "popularRequest": {
    "method": "GET",
    "firstPagePathTemplate": "/manga/",
    "pathTemplate": "/manga/?page={page}"
  },
  "latestRequest": {
    "method": "GET",
    "firstPagePathTemplate": "/",
    "pathTemplate": "/manga/?page={page}"
  },
  "searchRequest": {
    "method": "GET",
    "pathTemplate": "/manga/?q={query}&page={page}"
  },
  "pipelineSteps": [
    {
      "op": "referer_bind",
      "refererUrl": "https://www.leercapitulo.co/"
    }
  ],
