{
  "schemaVersion": 2,
  "sourceId": "es.lectortaurus",
  "name": "Taurus Fansub",
  "baseUrl": "https://lectortaurus.com",
  "lang": "es",
  "version": 2,
  "preset": "MADARA",
  "status": "ACTIVE",
  "catalogPath": "/manga",
  "useHomeFallback": true,
  "maxHtmlBytes": 2097152,
  "selectors": {
    "listSelector": "div.page-item-detail, div.c-tabs-item__content, div.manga__item",
    "titleSelector": "h3.h5 a, div.post-title a, h4 a",
    "linkSelector": "h3.h5 a, div.post-title a, a[href]",
    "chapterSelector": "li.wp-manga-chapter a",
    "pageImgSelector": "div.reading-content img.wp-manga-chapter-img, div.reading-content img",
    "coverSelector": "div.manga__thumb_item img"
  },
  "pipelineSteps": [
    {
      "op": "css_select",
      "selector": "div.page-item-detail",
      "attribute": "innerHTML"
    },
    {
      "op": "trim_normalize",
      "collapseWhitespace": true
    }
  ],
  "upstreamSourceId": 5157867187592331768,
  "upstreamRepo": "keiyoushi/extensions-source",
  "mirrors": [
    "https://lectortaurus.com"
  ],
  "upstreamExtVersionCode": 106071,
  "versionId": 1,
  "recipePath": "recipes/es.lectortaurus.json",
  "mode": "declarative",
  "upstreamSourceIds": [
    5157867187592331768
  ],
  "versionCode": 106071,
  "license": "Apache-2.0",
  "attribution": "The Tachiyomi / Keiyoushi Contributors",
  "pkgName": "eu.kanade.tachiyomi.extension.es.taurusfansub",
  "iconUrl": "https://cdn.jsdelivr.net/gh/keiyoushi/extensions-source@main/src/es/taurusfansub/res/mipmap-xhdpi/ic_launcher.png",
  "accountSync": {
    "loginUrl": "https://lectortaurus.com/wp-login.php",
    "loggedOutStatusCodes": [
      401,
      403
    ],
    "loggedOutBodyMarkers": [
      "c-modal_item",
      "wp-login.php"
    ],
    "loggedOutRedirectContains": [
      "wp-login.php"
    ],
    "maxPagesPerSection": 10,
    "sections": [
      {
        "kind": "FAVORITES",
        "format": "HTML",
        "request": {
          "pathTemplate": "/user-settings/?tab=bookmark&page={page}"
        },
        "itemsSelector": "table.list-bookmark tr:has(a[href*='/manga/']), div.c-tabs-item__content",
        "urlSelector": "div.m-name a, h3 a, div.post-title a, a[href*='/manga/']",
        "titleSelector": "div.m-name a, h3 a, div.post-title a, a[href*='/manga/']",
        "coverSelector": "img",
        "lastChapterSelector": "div.chapter a, span.chapter a, td.chapter a",
        "lastChapterUrlSelector": "div.chapter a, span.chapter a, td.chapter a",
        "nextPageSelector": "a.next.page-numbers, nav.navigation a.next"
      },
      {
        "kind": "READING_HISTORY",
        "format": "HTML",
        "request": {
          "pathTemplate": "/user-settings/?tab=history&page={page}"
        },
        "itemsSelector": "div.history-content div.row, div.c-tabs-item__content",
        "urlSelector": "div.item-infor h3 a, div.post-title a, a[href*='/manga/']",
        "titleSelector": "div.item-infor h3 a, div.post-title a, a[href*='/manga/']",
        "coverSelector": "img",
        "lastChapterSelector": "div.chapter a, span.chapter a",
        "lastChapterUrlSelector": "div.chapter a, span.chapter a",
        "nextPageSelector": "a.next.page-numbers, nav.navigation a.next"
      }
    ]
  },
  "curated": true
}
