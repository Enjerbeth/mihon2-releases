  "preset": "JSON_API",
  "status": "ACTIVE",
  "maxHtmlBytes": 2097152,
  "catalogPath": "/manga",
  "useHomeFallback": true,
  "headers": {
    "Referer": "https://manhuako.net/"
  },
  "selectors": null,
  "pipelineSteps": [
    {
      "op": "referer_bind",
      "refererUrl": "https://manhuako.net/"
    }
  ],
  "recipePath": "recipes/es.dynasty.json",
  "mode": "declarative",
