{
  "schemaVersion": 2,
  "sourceId": "en.luscious",
  "name": "Luscious",
  "baseUrl": "https://www.luscious.net",
  "lang": "en",
  "version": 3,
  "versionId": 1,
  "preset": "JSON_API",
  "status": "ACTIVE",
  "maxHtmlBytes": 2097152,
  "catalogPath": "/manga",
  "useHomeFallback": true,
  "headers": {
    "Referer": "https://www.luscious.net/"
  },
  "selectors": null,
  "pipelineSteps": [
    {
      "op": "referer_bind",
      "refererUrl": "https://www.luscious.net/"
    }
  ],
  "recipePath": "recipes/en.luscious.json",
  "mode": "declarative",
  "upstreamSourceIds": [
    2774395484485436593
  ],
  "license": "Apache-2.0",
  "attribution": "The Tachiyomi / Keiyoushi Contributors",
  "mirrors": [
    "https://www.luscious.net",
    "https://members.luscious.net"
  ],
  "iconUrl": "https://cdn.jsdelivr.net/gh/keiyoushi/extensions-source@main/src/all/luscious/res/mipmap-xhdpi/ic_launcher.png",
  "pkgName": "eu.kanade.tachiyomi.extension.all.luscious",
  "upstreamSourceId": 2774395484485436593,
  "upstreamExtVersionCode": 106003,
  "versionCode": 106003,
  "upstreamRepo": "keiyoushi/extensions-source",
  "jsonApi": {
    "apiBaseUrl": "https://apicdn.luscious.net",
    "popularRequest": {
      "method": "POST",
      "pathTemplate": "/graphql/nobatch/",
      "graphqlQuery": "query AlbumList($input: AlbumListInput!) { album { list(input: $input) { info { has_next_page } items { id title url cover { url } } } } }",
      "graphqlVariablesTemplate": "{\"input\":{\"display\":\"rating_all_time\",\"page\":{page},\"items_per_page\":24,\"filters\":[{\"name\":\"album_type\",\"value\":\"manga\"}]}}"
    },
    "latestRequest": {
      "method": "POST",
      "pathTemplate": "/graphql/nobatch/",
      "graphqlQuery": "query AlbumList($input: AlbumListInput!) { album { list(input: $input) { info { has_next_page } items { id title url cover { url } } } } }",
      "graphqlVariablesTemplate": "{\"input\":{\"display\":\"date_newest\",\"page\":{page},\"items_per_page\":24,\"filters\":[{\"name\":\"album_type\",\"value\":\"manga\"}]}}"
    },
    "searchRequest": {
      "method": "POST",
      "pathTemplate": "/graphql/nobatch/",
      "graphqlQuery": "query AlbumList($input: AlbumListInput!) { album { list(input: $input) { info { has_next_page } items { id title url cover { url } } } } }",
      "graphqlVariablesTemplate": "{\"input\":{\"display\":\"date_newest\",\"page\":{page},\"items_per_page\":24,\"filters\":[{\"name\":\"search_query\",\"value\":\"{rawQuery}\"},{\"name\":\"album_type\",\"value\":\"manga\"}]}}"
    },
    "detailsRequest": {
      "method": "POST",
      "pathTemplate": "/graphql/nobatch/",
      "graphqlQuery": "query AlbumGet($id: ID!) { album { get(id: $id) { id title description cover { url } genres { title } } } }",
      "graphqlVariablesTemplate": "{\"id\":\"{mangaId}\"}"
    },
    "chaptersRequest": {
      "method": "POST",
      "pathTemplate": "/graphql/nobatch/",
      "graphqlQuery": "query AlbumGet($id: ID!) { album { get(id: $id) { id title description cover { url } genres { title } } } }",
      "graphqlVariablesTemplate": "{\"id\":\"{mangaId}\"}"
    },
    "pagesRequest": {
      "method": "POST",
      "pathTemplate": "/graphql/nobatch/",
      "graphqlQuery": "query PictureListInsideAlbum($input: PictureListInput!) { picture { list(input: $input) { info { has_next_page } items { url_to_original url_to_video } } } }",
      "graphqlVariablesTemplate": "{\"input\":{\"display\":\"position\",\"album_id\":\"{mangaId}\",\"page\":1,\"items_per_page\":500}}"
    },
    "mangaList": {
      "itemsPath": "$.data.album.list.items[*]",
      "titlePaths": [
        "$.title"
      ],
      "urlPath": "$.url",
      "idPath": "$.id",
      "coverPaths": [
        "$.cover.url"
      ],
      "pagination": {
        "mode": "PAGE_NUMBER",
        "startPage": 1,
        "pageSize": 24
      }
    },
    "details": {
      "rootPath": "$.data.album.get",
      "titlePaths": [
        "$.title"
      ],
      "descriptionPaths": [
        "$.description"
      ],
      "coverPaths": [
        "$.cover.url"
      ],
      "genresPath": "$.genres[*].title"
    },
    "chapters": {
      "itemsPath": "$.data.album.get",
      "namePath": "$.title",
      "urlPath": "$.id",
      "idPath": "$.id"
    },
    "pages": {
      "itemsPath": "$.data.picture.list.items[*]",
      "imageUrlPath": "$.url_to_original"
    }
  },
  "requiresCloudflareBypass": true,
  "requiresWebViewCapture": false
}
