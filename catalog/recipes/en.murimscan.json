{
  "schemaVersion": 2,
  "sourceId": "en.murimscan",
  "name": "MurimScan",
  "baseUrl": "https://www.murimscans.site",
  "lang": "en",
  "version": 1,
  "versionId": 2,
  "preset": "JSON_API",
  "status": "ACTIVE",
  "maxHtmlBytes": 2097152,
  "catalogPath": "/feeds/posts/default?alt=json",
  "useHomeFallback": false,
  "headers": {
    "Referer": "https://www.murimscans.site/"
  },
  "selectors": {
    "listSelector": "$.feed.entry[*]"
  },
  "pipelineSteps": [
    {
      "op": "referer_bind",
      "refererUrl": "https://www.murimscans.site/"
    }
  ],
  "recipePath": "recipes/en.murimscan.json",
  "mode": "declarative",
  "upstreamSourceIds": [
    5524031489110351257
  ],
  "license": "Apache-2.0",
  "attribution": "The Tachiyomi / Keiyoushi Contributors",
  "jsonApi": {
    "apiBaseUrl": "https://www.murimscans.site",
    "popularRequest": {
      "method": "GET",
      "pathTemplate": "/feeds/posts/default?alt=json&start-index={page}&max-results=24",
      "headers": {
        "Accept": "application/json",
        "Referer": "https://www.murimscans.site/"
      }
    },
    "latestRequest": {
      "method": "GET",
      "pathTemplate": "/feeds/posts/default?alt=json&start-index={page}&max-results=24",
      "headers": {
        "Accept": "application/json",
        "Referer": "https://www.murimscans.site/"
      }
    },
    "searchRequest": {
      "method": "GET",
      "pathTemplate": "/feeds/posts/default?alt=json&q={query}&start-index={page}&max-results=24",
      "headers": {
        "Accept": "application/json",
        "Referer": "https://www.murimscans.site/"
      }
    },
    "mangaList": {
      "itemsPath": "$.feed.entry[*]",
      "titlePaths": [
        "$.title.$t"
      ],
      "urlPath": "$.link[?(@.rel=='alternate')].href",
      "coverPaths": [
        "$.media$thumbnail.url"
      ],
      "htmlExtract": {
        "titleSelector": "h1.entry-title, h1.post-title",
        "coverSelector": "div.post-body img, div.entry-content img",
        "baseUrl": "https://www.murimscans.site"
      },
      "pagination": {
        "mode": "PAGE_NUMBER",
        "startPage": 1,
        "pageSize": 24
      }
    },
    "details": {
      "rootPath": "$",
      "titlePaths": [
        "$.feed.entry[0].title.$t",
        "$.title.$t"
      ]
    },
    "chapters": {
      "itemsPath": "$.feed.entry[*]",
      "namePath": "$.title.$t",
      "urlPath": "$.link[?(@.rel=='alternate')].href",
      "datePath": "$.published.$t",
      "dateFormat": "iso",
      "htmlExtract": {
        "titleSelector": "h1.entry-title",
        "dateSelector": "time",
        "baseUrl": "https://www.murimscans.site"
      }
    },
    "pages": {
      "itemsPath": "$.feed.entry[*]",
      "readerHtmlPageSelector": "div.post-body img, div.entry-content img",
      "requiresReaderHtmlFallback": true
    }
  },
  "mirrors": [
    "https://www.murimscans.site"
  ],
  "iconUrl": "https://cdn.jsdelivr.net/gh/keiyoushi/extensions-source@main/src/en/murimscan/res/mipmap-xhdpi/ic_launcher.png",
  "pkgName": "eu.kanade.tachiyomi.extension.en.murimscan",
  "upstreamSourceId": 5524031489110351257,
  "upstreamExtVersionCode": 106056,
  "versionCode": 106056,
  "upstreamRepo": "keiyoushi/extensions-source"
}
